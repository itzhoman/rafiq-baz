# Reference only: set these environment variables before starting Uvicorn.
# Use a private, backed-up database on a production Python host.
RB_DATABASE=backend/data/demo.sqlite3
RB_GOOGLE_CLIENT_ID=
# Set 1 behind a production HTTPS reverse proxy.
RB_SECURE_COOKIES=0
RB_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
