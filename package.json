{
  "name": "rafiq-baz",
  "version": "0.3.0",
  "private": true,
  "description": "Rafiq Baz — Angular dashboard, Android and iOS app with Python API",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "test:recommendations": "node --experimental-strip-types scripts/test-recommendations.ts",
    "test:profiles": "node --experimental-strip-types scripts/test-demo-profiles.ts",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@capacitor/cli": "8.5.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
